---
// One 404 for both languages (static hosts serve a single 404 page).
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { categories } from "../data/catalog";
---
<Base title="Page not found / ಪುಟ ಸಿಗಲಿಲ್ಲ">
  <section class="section nf">
    <div class="wrap">
      <p class="nf__code">404</p>
      <h1>This route isn't on our delivery map</h1>
      <p class="lede">The page you're looking for has moved or doesn't exist.</p>
      <p class="lede" lang="kn">ನೀವು ಹುಡುಕುತ್ತಿರುವ ಪುಟ ಸ್ಥಳಾಂತರಗೊಂಡಿದೆ ಅಥವಾ ಅಸ್ತಿತ್ವದಲ್ಲಿಲ್ಲ.</p>
      <div class="btn-row">
        <a class="btn btn--red" href="/">Go to home</a>
        <a class="btn btn--sun" href="/kn/" lang="kn">ಮುಖಪುಟಕ್ಕೆ ಹೋಗಿ</a>
        <a class="btn btn--ghost" href="/products/">Browse products</a>
      </div>
      <ul class="nf__links">
        {categories.map((c) => <li><a href={`/products/${c.slug}/`}>{c.name} <Icon name="arrow" size={16} /></a></li>)}
      </ul>
    </div>
  </section>
</Base>

<style>
  .nf { min-height: 60vh; }
  .nf__code { font-family: var(--font-display); font-weight: 800; font-size: clamp(5rem, 22vw, 10rem); line-height: 1; margin: 0; color: var(--sun); -webkit-text-stroke: 3px var(--ink); }
  .nf__links { list-style: none; padding: 0; margin: 32px 0 0; display: grid; gap: 8px; max-width: 520px; }
  .nf__links a { display: flex; justify-content: space-between; align-items: center; padding: 14px 16px; border-radius: 12px; background: var(--card); border: 1px solid var(--line); text-decoration: none; font-weight: 600; }
</style>
