---
import Icon from "./Icon.astro";
import { site, nav, waLink } from "../data/site";
import { getLang, stripLang, lp, alternatePath } from "../i18n";
import { t } from "../i18n/ui";

const lang = getLang(Astro.url);
const s = t(lang);
const other = lang === "en" ? "kn" : "en";
const switchHref = alternatePath(Astro.url, other);
const path = stripLang(Astro.url.pathname);
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
const waHello = waLink(s.waHello);
---
<div class="topbar" aria-label={s.contactInfo}>
  <div class="wrap wrap--wide topbar__inner">
    <span class="topbar__city"><Icon name="pin" size={16} /> {site.address.city[lang]}<span class="topbar__state">, {site.address.state[lang]}</span></span>
    <a href={`tel:${site.phones[0].tel}`}><Icon name="phone" size={16} /> {site.phones[0].display}</a>
    <a class="topbar__phone2" href={`tel:${site.phones[1].tel}`}>{site.phones[1].display}</a>
    <a class="topbar__mail" href={`mailto:${site.email}`} aria-label={site.email}><Icon name="mail" size={16} /> <span class="topbar__mail-text">{site.email}</span></a>
    <span class="topbar__tag">{site.segments[lang]}</span>
  </div>
</div>

<header class="header" id="top">
  <div class="wrap wrap--wide header__inner">
    <a class="brand" href={lp(lang, "/")} aria-label={s.homeAria}>
      <img src="/images/logo.webp" width="54" height="54" alt="" />
      <span class="brand__text">
        <span class="brand__name">Karunadu <em>Distributors</em></span>
        <span class="brand__tag">{site.tagline[lang]}</span>
      </span>
    </a>

    <nav class="nav" aria-label={s.mainNav}>
      <ul>
        {nav.map((item) => (
          <li><a href={lp(lang, item.href)} aria-current={isActive(item.href) ? "page" : undefined}>{item.label[lang]}</a></li>
        ))}
      </ul>
    </nav>

    <div class="header__actions">
      <a class="lang-switch" href={switchHref} hreflang={other} lang={other} aria-label={s.switchLangAria} data-lang-switch>
        {s.switchLang}
      </a>
      <button class="order-btn" type="button" data-open-order aria-label={s.openOrderList}>
        <Icon name="list" size={22} />
        <span class="order-btn__label">{s.orderList}</span>
        <span class="badge" data-order-count hidden>0</span>
      </button>
      <a class="btn btn--wa btn--sm header__wa" aria-label={s.chatWhatsapp} href={waHello} target="_blank" rel="noopener">
        <Icon name="whatsapp" /> <span class="header__wa-label">{s.whatsapp}</span>
      </a>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="drawer" data-menu-toggle>
        <Icon name="menu" size={26} /><span class="visually-hidden">{s.menuOpen}</span>
      </button>
    </div>
  </div>
  <div class="flagbar" aria-hidden="true"></div>
</header>

<div class="drawer" id="drawer" hidden data-drawer>
  <div class="drawer__scrim" data-menu-close></div>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-label={s.menu}>
    <div class="drawer__head">
      <span class="kn drawer__kn" lang="kn">{site.nameKn}</span>
      <button class="menu-btn" type="button" data-menu-close aria-label={s.menuClose}><Icon name="close" size={26} /></button>
    </div>
    <ul class="drawer__nav">
      {nav.map((item) => (
        <li>
          <a href={lp(lang, item.href)} aria-current={isActive(item.href) ? "page" : undefined}>
            {item.label[lang]}<Icon name="arrow" size={20} />
          </a>
        </li>
      ))}
    </ul>
    <div class="drawer__lang" role="group" aria-label="Language / ಭಾಷೆ">
      <a href={alternatePath(Astro.url, "en")} lang="en" hreflang="en" aria-current={lang === "en" ? "true" : undefined} data-lang-switch>English</a>
      <a href={alternatePath(Astro.url, "kn")} lang="kn" hreflang="kn" aria-current={lang === "kn" ? "true" : undefined} data-lang-switch>ಕನ್ನಡ</a>
    </div>
    <div class="drawer__contact">
      <a class="btn btn--wa btn--block" href={waHello} target="_blank" rel="noopener"><Icon name="whatsapp" /> {s.chatWhatsapp}</a>
      <a class="btn btn--ghost btn--block" href={`tel:${site.phones[0].tel}`}><Icon name="phone" /> {site.phones[0].display}</a>
      <p class="drawer__meta"><Icon name="clock" size={16} /> {site.hours[lang]}</p>
    </div>
  </div>
</div>

<script>
  const drawer = document.querySelector<HTMLElement>("[data-drawer]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  if (drawer && toggle) {
    const open = () => {
      drawer.hidden = false;
      toggle.setAttribute("aria-expanded", "true");
      document.documentElement.style.overflow = "hidden";
      drawer.querySelector<HTMLElement>(".drawer__nav a")?.focus();
    };
    const close = () => {
      drawer.hidden = true;
      toggle.setAttribute("aria-expanded", "false");
      document.documentElement.style.overflow = "";
      toggle.focus();
    };
    toggle.addEventListener("click", open);
    drawer.querySelectorAll("[data-menu-close]").forEach((el) => el.addEventListener("click", close));
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !drawer.hidden) close(); });
  }
  // Keep in-page anchors and filters when switching language (e.g. /retailers/#retailer-form).
  document.querySelectorAll<HTMLAnchorElement>("[data-lang-switch]").forEach((a) => {
    a.addEventListener("click", () => {
      a.search = window.location.search;
      a.hash = window.location.hash;
    });
  });
  const header = document.querySelector(".header");
  if (header) {
    const onScroll = () => header.classList.toggle("is-scrolled", window.scrollY > 8);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>

<style>
  .topbar { background: var(--leaf); color: #fff; font-size: 0.8rem; }
  .topbar__inner { display: flex; align-items: center; gap: 14px; min-height: 34px; }
  .topbar__inner > * { display: inline-flex; align-items: center; gap: 6px; text-decoration: none; opacity: 0.92; white-space: nowrap; }
  .topbar__inner a:hover { opacity: 1; text-decoration: underline; }
  .topbar__tag { margin-left: auto; background: var(--sun); color: var(--ink); font-weight: 700; padding: 2px 10px; border-radius: 6px; font-size: 0.74rem; letter-spacing: 0.06em; opacity: 1; }
  /* Phones: city, main number and a mail icon. Wider screens add the rest. */
  .topbar .topbar__state, .topbar .topbar__phone2, .topbar .topbar__tag, .topbar .topbar__mail-text { display: none; }
  .topbar .topbar__mail { margin-left: auto; }
  @media (min-width: 480px) { .topbar .topbar__phone2 { display: inline-flex; } }
  @media (min-width: 640px) { .topbar .topbar__mail-text { display: inline; } }
  @media (min-width: 1024px) {
    .topbar { font-size: 0.85rem; }
    .topbar__inner { gap: 22px; min-height: 40px; }
    .topbar .topbar__state { display: inline; }
    .topbar .topbar__mail { margin-left: 0; }
    .topbar .topbar__tag { display: inline-flex; }
  }

  .header { position: sticky; top: 0; z-index: 50; background: rgba(255, 250, 241, 0.94); backdrop-filter: saturate(1.4) blur(10px); transition: box-shadow 0.2s; }
  .header.is-scrolled { box-shadow: 0 6px 20px -12px rgba(29, 22, 17, 0.35); }
  .header__inner { display: flex; align-items: center; gap: 10px; height: var(--header-h); }
  .header .flagbar { height: 4px; }

  .brand { display: flex; align-items: center; gap: 8px; text-decoration: none; min-width: 0; }
  .brand img { width: 42px; height: 42px; flex: none; }
  @media (min-width: 768px) { .brand img { width: 54px; height: 54px; } .brand { gap: 10px; } }
  .brand__text { display: grid; line-height: 1.1; min-width: 0; }
  .brand__name { font-family: var(--font-display); font-weight: 800; font-size: 1rem; letter-spacing: -0.02em; text-transform: uppercase; white-space: nowrap; }
  .brand__name em { font-style: normal; color: var(--chilli); }
  .brand__tag { font-size: 0.66rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--leaf-2); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  :lang(kn) .brand__tag { letter-spacing: 0; text-transform: none; font-size: 0.72rem; }
  /* Small phones: stack the wordmark so the language switch fits beside it. */
  @media (max-width: 439px) {
    .brand__name em { display: block; }
    .brand__name { line-height: 1.05; }
    .brand__tag { display: none; }
  }
  @media (min-width: 768px) { .brand__name { font-size: 1.3rem; } .brand__tag { font-size: 0.7rem; } }
  @media (min-width: 1180px) { .brand { flex: none; } .brand__tag { display: none; } }
  @media (min-width: 1360px) { .brand__tag { display: block; } }

  .nav { display: none; margin-left: auto; }
  @media (min-width: 1180px) { .nav { display: block; } }
  .nav ul { display: flex; gap: 2px; list-style: none; margin: 0; padding: 0; }
  .nav a { display: block; padding: 8px 10px; border-radius: 999px; text-decoration: none; font-weight: 600; font-size: 0.93rem; white-space: nowrap; transition: background-color 0.15s; }
  :lang(kn) .nav a { font-size: 0.9rem; padding: 8px 9px; }
  .nav a:hover { background: var(--paper-2); }
  .nav a[aria-current="page"] { background: var(--ink); color: #fff; }

  .header__actions { display: flex; align-items: center; gap: 8px; margin-left: auto; }
  @media (min-width: 1180px) { .header__actions { margin-left: 8px; } }
  .order-btn { display: none; position: relative; align-items: center; gap: 8px; height: 44px; padding: 0 12px; border-radius: 999px; border: 1.5px solid var(--line); background: var(--card); cursor: pointer; font-weight: 700; }
  @media (min-width: 1024px) { .order-btn { display: inline-flex; } }
  .order-btn:hover { border-color: var(--ink); }
  .order-btn__label { display: none; }
  @media (min-width: 1440px) { .order-btn__label { display: inline; white-space: nowrap; } }
  .badge { position: absolute; top: -4px; right: -4px; min-width: 20px; height: 20px; padding: 0 5px; border-radius: 999px; background: var(--chilli); color: #fff; font-size: 0.72rem; font-weight: 800; display: grid; place-items: center; }
  .badge[hidden] { display: none; }
  .header__wa { display: none; }
  @media (min-width: 1024px) { .header__wa { display: inline-flex; padding-inline: 12px; } }
  .header__wa-label { display: none; }
  @media (min-width: 1440px) { .header__wa-label { display: inline; } .header__wa { padding-inline: 16px; } }

  .menu-btn { width: 44px; height: 44px; flex: none; display: grid; place-items: center; border-radius: 12px; border: 0; background: var(--ink); color: #fff; cursor: pointer; }
  @media (min-width: 1180px) { .header .menu-btn { display: none; } }

  .drawer { position: fixed; inset: 0; z-index: 90; }
  .drawer[hidden] { display: none; }
  .drawer__scrim { position: absolute; inset: 0; background: rgba(29, 22, 17, 0.5); }
  .drawer__panel { position: absolute; top: 0; right: 0; bottom: 0; width: min(88vw, 380px); background: var(--paper); display: flex; flex-direction: column; padding: 16px 20px calc(20px + env(safe-area-inset-bottom)); overflow-y: auto; animation: slideIn 0.22s var(--ease); }
  @keyframes slideIn { from { transform: translateX(24px); opacity: 0; } }
  .drawer__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
  .drawer__kn { font-weight: 700; color: var(--chilli); }
  .drawer__nav { list-style: none; margin: 0; padding: 0; }
  .drawer__nav a { display: flex; align-items: center; justify-content: space-between; padding: 15px 4px; border-bottom: 1px solid var(--line); text-decoration: none; font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; }
  .drawer__nav a[aria-current="page"] { color: var(--chilli); }
  .drawer__lang { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; padding: 5px; margin-top: 18px; background: var(--paper-2); border-radius: 14px; }
  .drawer__lang a { display: grid; place-items: center; min-height: 44px; border-radius: 10px; text-decoration: none; font-weight: 700; }
  .drawer__lang a[aria-current="true"] { background: var(--ink); color: #fff; }
  .drawer__contact { margin-top: auto; display: grid; gap: 10px; padding-top: 24px; }
  .drawer__meta { display: flex; align-items: center; gap: 8px; justify-content: center; color: var(--muted); font-size: 0.9rem; margin: 4px 0 0; }
</style>
