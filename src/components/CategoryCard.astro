---
import Icon from "./Icon.astro";
import Img from "./Img.astro";
import Tile from "./Tile.astro";
import { subsOf, productsInCategory, catName, catBlurb, subName, type Category } from "../data/catalog";
import { getLang, lp } from "../i18n";
import { t } from "../i18n/ui";
import { resolveImage } from "../lib/images";

interface Props { category: Category; index: number; }
const { category, index } = Astro.props;
const lang = getLang(Astro.url);
const s = t(lang);
const subs = subsOf(category.slug);
const firstProductImage = productsInCategory(category.slug).find((p) => p.image)?.image;
const image = resolveImage(category.image, firstProductImage, subs[0]?.image);
const icons: Record<string, string> = { "hydration-coolers": "bottle", "ready-to-cook": "spice", "accompaniments-dairy": "jar", "snacks-sweets": "chips", "baking-dessert": "cake" };
---
<a class={`ccard ccard--${category.tone} reveal`} href={lp(lang, `/products/${category.slug}/`)}>
  <div class="ccard__media">
    {image ? <Img image={image} alt="" sizes="(min-width: 900px) 33vw, 100vw" /> : <Tile icon={icons[category.slug] ?? "box"} tone={category.tone} />}
    <span class="ccard__num">{String(index + 1).padStart(2, "0")}</span>
    {category.priority && <span class="ccard__flag">{s.topPriority}</span>}
  </div>
  <div class="ccard__body">
    <h3>{catName(category, lang)}</h3>
    <p>{catBlurb(category, lang)}</p>
    <ul class="ccard__subs">{subs.map((sub) => <li>{subName(sub, lang)}</li>)}</ul>
    <span class="ccard__go">{s.viewRange} <Icon name="arrow" size={18} /></span>
  </div>
</a>

<style>
  .ccard { display: flex; flex-direction: column; text-decoration: none; background: var(--card); border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); transition: box-shadow 0.2s, transform 0.2s; }
  .ccard:hover { box-shadow: var(--shadow-lg); transform: translateY(-3px); }
  .ccard__media { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: var(--paper-2); }
  .ccard__media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s var(--ease); }
  .ccard:hover .ccard__media :global(img) { transform: scale(1.03); }
  .ccard__num { position: absolute; right: 12px; bottom: 10px; font-family: var(--font-display); font-weight: 800; font-size: 2.4rem; line-height: 1; color: #fff; text-shadow: 0 2px 14px rgba(0, 0, 0, 0.45); }
  .ccard__flag { position: absolute; left: 12px; top: 12px; background: var(--sun); color: var(--ink); font-weight: 800; font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; padding: 4px 10px; border-radius: 999px; }
  .ccard__body { padding: 18px 18px 20px; display: flex; flex-direction: column; flex: 1; border-top: 5px solid var(--accent); }
  .ccard--red { --accent: var(--chilli); }
  .ccard--yellow { --accent: var(--sun); }
  .ccard--green { --accent: var(--leaf-2); }
  .ccard--orange { --accent: var(--mango); }
  .ccard--plum { --accent: var(--plum); }
  .ccard__body h3 { margin-bottom: 6px; }
  .ccard__body p { color: var(--muted); font-size: 0.95rem; }
  .ccard__subs { list-style: none; margin: 0 0 16px; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .ccard__subs li { font-size: 0.76rem; font-weight: 600; padding: 3px 9px; border-radius: 999px; background: var(--paper-2); color: var(--ink-2); }
  .ccard__go { margin-top: auto; display: inline-flex; align-items: center; gap: 6px; font-weight: 800; color: var(--chilli); }
</style>
