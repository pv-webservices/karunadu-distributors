---
import Icon from "./Icon.astro";
import { site, nav, waLink, fullAddress } from "../data/site";
import { categories, catName } from "../data/catalog";
import { getLang, lp } from "../i18n";
import { t } from "../i18n/ui";
const lang = getLang(Astro.url);
const s = t(lang);
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="flagbar" aria-hidden="true"></div>
  <div class="wrap footer__grid">
    <div class="footer__brand">
      <a class="footer__logo" href={lp(lang, "/")}>
        <img src="/images/logo.webp" width="44" height="44" alt="" loading="lazy" />
        <span>Karunadu <em>Distributors</em></span>
      </a>
      <p class="kn footer__kn" lang="kn">{site.nameKn}</p>
      <p>{s.footerBlurb}</p>
      <a class="btn btn--sun btn--sm" href={waLink(s.waOrder)} target="_blank" rel="noopener">
        <Icon name="whatsapp" /> {s.orderOnWa}
      </a>
    </div>

    <div>
      <h2 class="footer__title">{s.explore}</h2>
      <ul class="footer__list">
        {nav.map((n) => <li><a href={lp(lang, n.href)}>{n.label[lang]}</a></li>)}
      </ul>
    </div>

    <div>
      <h2 class="footer__title">{s.categories}</h2>
      <ul class="footer__list">
        {categories.map((c) => <li><a href={lp(lang, `/products/${c.slug}/`)}>{catName(c, lang)}</a></li>)}
      </ul>
    </div>

    <div>
      <h2 class="footer__title">{s.reachUs}</h2>
      <ul class="footer__list footer__contact">
        <li><Icon name="pin" size={18} /><span>{fullAddress(lang)}</span></li>
        {site.phones.map((p) => <li><Icon name="phone" size={18} /><a href={`tel:${p.tel}`}>{p.display}</a></li>)}
        <li><Icon name="mail" size={18} /><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><Icon name="clock" size={18} /><span>{site.hours[lang]}</span></li>
      </ul>
    </div>
  </div>
  <div class="wrap footer__bottom">
    <span>© {year} {site.name}. {s.rights}</span>
    <span lang={lang === "en" ? "kn" : "en"}>{s.footerLine}</span>
  </div>
</footer>

<style>
  .footer { background: #10311f; color: rgba(255, 255, 255, 0.86); }
  .footer__grid { display: grid; gap: 32px; padding-top: 48px; padding-bottom: 32px; }
  @media (min-width: 720px) { .footer__grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .footer__grid { grid-template-columns: 1.4fr 0.8fr 1.2fr 1.3fr; gap: 40px; padding-top: 64px; } }
  .footer__logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font-family: var(--font-display); font-weight: 800; font-size: 1.25rem; text-transform: uppercase; color: #fff; }
  .footer__logo em { font-style: normal; color: var(--sun); }
  .footer__kn { color: var(--sun); font-weight: 600; margin: 8px 0 10px; }
  .footer__brand p { max-width: 38ch; font-size: 0.95rem; }
  .footer__title { font-family: var(--font-body); font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--sun); margin-bottom: 14px; }
  :lang(kn) .footer__title { letter-spacing: 0.02em; font-size: 0.9rem; }
  .footer__list { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; font-size: 0.95rem; }
  .footer__list a { text-decoration: none; }
  .footer__list a:hover { color: #fff; text-decoration: underline; text-underline-offset: 3px; }
  .footer__contact li { display: grid; grid-template-columns: 20px 1fr; gap: 10px; align-items: start; }
  .footer__contact :global(svg) { margin-top: 3px; color: var(--sun); }
  .footer__bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; padding-top: 18px; padding-bottom: 22px; border-top: 1px solid rgba(255, 255, 255, 0.12); font-size: 0.85rem; color: rgba(255, 255, 255, 0.6); }
</style>
