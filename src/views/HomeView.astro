const hero = resolveImage("hero-distribution", "delivery-van");
const featured = products.filter((p) => p.featured).slice(0, 8);
const posters = ["poster-tusk-cashback", "poster-beekay-store", "poster-beekay-independence", "poster-beekay-eid"]
  .map((id, i) => ({ id, alt: copy.posterAlts[i], image: resolveImage(id) }))
  .filter((p) => p.image);
---
<Base title={copy.title}>
  <section class="hero">
    <div class="wrap wrap--wide hero__grid">
      <div class="hero__text">
        <p class="hero__pill"><Icon name="pin" size={16} /> {copy.pill}</p>
        <h1>{copy.h1[0]}<span class="hl">{copy.h1[1]}</span>{copy.h1[2]}</h1>
        <p class="lede" set:html={copy.lede} />
        <div class="hero__cta">
          <a class="btn btn--red" href={lp(lang, "/retailers/")}><Icon name="store" /> {copy.ctaShop}</a>
          <a class="btn btn--ghost" href={lp(lang, "/manufacturers/")}><Icon name="factory" /> {copy.ctaBrand}</a>
        </div>
      </div>
      <div class="hero__visual">
        {hero && (
          <div class="hero__img">
            <Img image={hero} alt={copy.heroAlt} eager sizes="(min-width: 900px) 52vw, 100vw" largeWidth={hero.source === "generated" ? 1600 : 1280} smallWidth={hero.source === "generated" ? 800 : 720} />
          </div>
        )}
        <div class="hero__card">
          <span class="hero__card-icon"><Icon name="truck" size={26} /></span>
          <div>
            <strong>{copy.cardTitle}</strong>
            <span>{copy.cardText}</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="stats" aria-label={copy.statsAria}>
    <div class="wrap stats__grid">
      {site.stats.map((st) => (
        <div class="stat">
          <span class="stat__value">{st.value[lang]}</span>
          <span class="stat__label">{st.label[lang]}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head reveal">
        <p class="eyebrow">{copy.audEyebrow}</p>
        <h2>{copy.audTitle}</h2>
        <p class="lede">{copy.audLede}</p>
      </div>
      <div class="grid grid-2">
        <article class="aud aud--retail reveal">
          <span class="aud__icon"><Icon name="store" size={28} /></span>
          <h3>{copy.retail.title}</h3>
          <p>{copy.retail.text}</p>
          <ul class="ticks">
            {copy.retail.ticks.map(([a, b]) => <li><span><strong>{a}</strong>{b}</span></li>)}
          </ul>
          <a class="btn btn--red" href={lp(lang, "/retailers/")}>{copy.retail.btn} <Icon name="arrow" /></a>
        </article>
        <article class="aud aud--brand reveal">
          <span class="aud__icon"><Icon name="factory" size={28} /></span>
          <h3>{copy.brand.title}</h3>
          <p>{copy.brand.text}</p>
          <ul class="ticks">
            {copy.brand.ticks.map(([a, b]) => <li><span><strong>{a}</strong>{b}</span></li>)}
          </ul>
          <a class="btn btn--leaf" href={lp(lang, "/manufacturers/")}>{copy.brand.btn} <Icon name="arrow" /></a>
        </article>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap">
      <div class="head reveal">
        <p class="eyebrow">{copy.catEyebrow}</p>
        <h2>{copy.catTitle}</h2>
        <p class="lede">{copy.catLede}</p>
      </div>
      <div class="grid grid-3 cats">
        {categories.map((c, i) => <CategoryCard category={c} index={i} />)}
        <a class="cats__all reveal" href={lp(lang, "/products/")}>
          <Icon name="box" size={34} />
          <strong>{copy.catAll}</strong>
          <span>{copy.catAllCount} <Icon name="arrow" size={18} /></span>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head-row reveal">
        <div class="head">
          <p class="eyebrow">{copy.featEyebrow}</p>
          <h2>{copy.featTitle}</h2>
          <p class="lede" set:html={copy.featLede} />
        </div>
        <a class="textlink" href={lp(lang, "/products/")}>{copy.allProducts} <Icon name="arrow" /></a>
      </div>
      <div class="products-grid">
        {featured.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap">
      <div class="head head--center reveal">
        <p class="eyebrow">{copy.stepsEyebrow}</p>
        <h2>{copy.stepsTitle}</h2>
      </div>
      <ol class="steps reveal">
        {copy.steps.map(([a, b]) => <li><h3>{a}</h3><p>{b}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head head--center reveal">
        <p class="eyebrow">{copy.brandsEyebrow}</p>
        <h2>{copy.brandsTitle}</h2>
      </div>
      <ul class="brands reveal" lang="en">
        {brands.map((b) => <li>{b}</li>)}
      </ul>
    </div>
  </section>

  {posters.length > 0 && (
    <section class="section section--ink campaigns">
      <div class="wrap">
        <div class="head reveal">
          <p class="eyebrow">{copy.campEyebrow}</p>
          <h2>{copy.campTitle}</h2>
          <p class="lede">{copy.campLede}</p>
