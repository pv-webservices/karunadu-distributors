    brandsEyebrow: "ನಮ್ಮಲ್ಲಿರುವ ಬ್ರ್ಯಾಂಡ್‌ಗಳು",
    brandsTitle: "ನಂಬಿಕೆಯ ಹೆಸರುಗಳು, ನಿರಂತರ ಬೇಡಿಕೆ",
    campEyebrow: "ಬ್ರ್ಯಾಂಡ್ ಪ್ರಚಾರಗಳು",
    campTitle: "ನಿಮ್ಮ ಪ್ರಚಾರಗಳನ್ನು ಶೆಲ್ಫ್‌ವರೆಗೆ ತಲುಪಿಸುತ್ತೇವೆ",
    campLede: "ಪಾಲುದಾರ ಬ್ರ್ಯಾಂಡ್‌ಗಳ ಹಬ್ಬದ ಆಫರ್‌ಗಳು, ಕ್ಯಾಶ್‌ಬ್ಯಾಕ್ ಯೋಜನೆಗಳು ಮತ್ತು ಋತುಮಾನದ ಪ್ರಚಾರಗಳು ನಮ್ಮ ಮಾರಾಟ ತಂಡ ಮತ್ತು ವಾಟ್ಸಾಪ್ ಜಾಲದ ಮೂಲಕ ಅಂಗಡಿಗಳಿಗೆ ತಲುಪುತ್ತವೆ.",
