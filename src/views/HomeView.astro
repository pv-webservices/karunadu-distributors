    posterAlts: ["ಟಸ್ಕ್ ಸಾಫ್ಟ್ ಡ್ರಿಂಕ್ಸ್ ₹50 ಕ್ಯಾಶ್‌ಬ್ಯಾಕ್ ಪ್ರಚಾರ ಪೋಸ್ಟರ್", "ಬೀಕೇ ಜ್ಯೂಸೀ ಕುಲ್ಕಿ ಜ್ಯೂಸ್ ಪ್ರಚಾರ ಪೋಸ್ಟರ್", "ಬೀಕೇ ಜ್ಯೂಸೀ ಸ್ವಾತಂತ್ರ್ಯ ದಿನಾಚರಣೆ ಪೋಸ್ಟರ್", "ಬೀಕೇ ಜ್ಯೂಸೀ ಬಕ್ರೀದ್ ಶುಭಾಶಯ ಪೋಸ್ಟರ್"],
    enqEyebrow: "ಸಂಪರ್ಕಿಸಿ",
    enqTitle: "ನಿಮಗೆ ಏನು ಬೇಕು ತಿಳಿಸಿ",
    enqLede: "ನಿಮ್ಮ ಅಗತ್ಯ ಆಯ್ಕೆ ಮಾಡಿ — ನಿಮ್ಮ ವಿವರಗಳೊಂದಿಗೆ ವಾಟ್ಸಾಪ್ ತೆರೆಯುತ್ತದೆ. ಸಾಮಾನ್ಯವಾಗಿ ಕೆಲವೇ ಕೆಲಸದ ಗಂಟೆಗಳಲ್ಲಿ ನಮ್ಮ ತಂಡ ಉತ್ತರಿಸುತ್ತದೆ.",
    callUs: "ಕರೆ ಮಾಡಿ",
    emailLabel: "ಇಮೇಲ್",
    hoursLabel: "ಸಮಯ",
    quickWa: "ತಕ್ಷಣ ವಾಟ್ಸಾಪ್ ಚಾಟ್",
    mapTitle: "ನಕ್ಷೆಯಲ್ಲಿ ನಮ್ಮನ್ನು ಹುಡುಕಿ",
    openMap: "ಗೂಗಲ್ ಮ್ಯಾಪ್ಸ್‌ನಲ್ಲಿ ತೆರೆಯಿರಿ",
    waHi: "ನಮಸ್ಕಾರ ಕರುನಾಡು ಡಿಸ್ಟ್ರಿಬ್ಯೂಟರ್ಸ್!",
  },
