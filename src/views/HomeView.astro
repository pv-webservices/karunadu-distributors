        ))}
      </ul>
    </section>
  )}

  <VanBanner />

  <section class="section" id="enquiry">
    <div class="wrap split">
      <div class="reveal">
        <p class="eyebrow">{copy.enqEyebrow}</p>
        <h2>{copy.enqTitle}</h2>
        <p class="lede">{copy.enqLede}</p>
        <ul class="ticks">
          <li><span><strong>{copy.callUs}</strong>{site.phones.map((p, i) => <>{i > 0 && " / "}<a href={`tel:${p.tel}`}>{p.display}</a></>)}</span></li>
          <li><span><strong>{copy.emailLabel}</strong><a href={`mailto:${site.email}`}>{site.email}</a></span></li>
          <li><span><strong>{copy.hoursLabel}</strong>{site.hours[lang]}</span></li>
        </ul>
        <a class="btn btn--wa enq-wa" href={waLink(copy.waHi)} target="_blank" rel="noopener"><Icon name="whatsapp" /> {copy.quickWa}</a>
        <div class="home-map">
          <iframe title={`${copy.mapTitle}: ${fullAddress(lang)}`} src={mapEmbedUrl(lang)} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
        </div>
        <p class="home-map__cap"><Icon name="pin" size={16} /> <span>{fullAddress(lang)}</span> <a href={site.mapsLink} target="_blank" rel="noopener">{copy.openMap}</a></p>
      </div>
      <div class="reveal"><EnquiryForm /></div>
    </div>
  </section>
</Base>

