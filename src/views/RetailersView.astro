---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import ProductCard from "../components/ProductCard.astro";
import EnquiryForm from "../components/EnquiryForm.astro";
import { site, waLink } from "../data/site";
import { products } from "../data/catalog";
import { resolveImage } from "../lib/images";
import { getLang, lp } from "../i18n";

const lang = getLang(Astro.url);
const nearAreas = site.serviceAreas[lang].slice(0, 4).join(", ");
const copy = {
  en: {
    title: "For Retailers",
    description: "Stock fast-moving beverages, snacks, spices and FMCG products for your shop in Bengaluru. Order on WhatsApp with flexible delivery from Karunadu Distributors.",
    eyebrow: "For retail shops",
    h1: "Keep your shelves full with fast-moving stock",
    lede: "Kirana stores, supermarkets, bakeries, cafés and wholesalers across Bengaluru rely on us for dependable supply of the beverages and FMCG products their customers ask for.",
    heroAlt: "Retail shop receiving stock from Karunadu Distributors",
    register: "Register your shop",
    priceList: "Get price list",
    priceMsg: "Hello Karunadu Distributors, please share the latest price list for my shop.",
    whyEyebrow: "Why stock with us",
    whyTitle: "Built around how shops actually work",
    benefits: [["Order on WhatsApp", "Send your list any time — no app downloads, no logins, no complicated software."], ["Flexible delivery", "Regular beat routes across Bengaluru so you can restock before you run out."], ["Healthy margins", "Competitive trade pricing designed to protect your profit on every case."], ["Products that sell", "Trending kulki drinks, goli sodas, snacks and kitchen staples customers ask for."], ["Schemes & offers", "We pass on brand schemes, festive offers and new-launch deals as they come."], ["One point of contact", "A dedicated person for your area who knows your shop and your orders."]],
    howEyebrow: "How ordering works",
    howTitle: "Four steps, no paperwork",
    steps: [["Build your list", "Use <strong>Add to order</strong> on any product, or simply type your list."], ["Send on WhatsApp", "Add your shop name and area, then tap send."], ["Confirm & schedule", "We confirm stock, prices and your delivery slot."], ["Receive & sell", "We deliver to your door at a slot that suits you."]],
    startEyebrow: "Start your order",
    startTitle: "Customer favourites",
    fullCatalogue: "Full catalogue",
    orderCta: "<strong>Got your list ready?</strong> Open your order list and send it on WhatsApp.",
    viewList: "View order list",
    faqEyebrow: "Questions",
    faqTitle: "Retailer FAQs",
    faqs: [
      ["Is there a minimum order quantity?", "Minimums depend on the product and your area. Share your list on WhatsApp and our team will confirm what works for your shop — small kirana stores are very welcome."],
      ["Which areas do you deliver to?", `We deliver across Bengaluru, with fastest coverage in ${nearAreas}. Statewide orders are handled through our Karnataka network.`],
      ["How quickly will I receive my order?", "Confirmed orders are delivered on our regular local routes — we'll agree a delivery slot that suits your shop."],
      ["How do I get the latest price list?", "Tap “Get price list” or message us on WhatsApp — we'll send the current catalogue and trade prices for your area."],
      ["How do I pay?", "Payment terms are confirmed with our team when you place your first order. We'll share the options available for your shop."],
    ],
  },
  kn: {
    title: "ಅಂಗಡಿಗಳಿಗೆ",
    description: "ನಿಮ್ಮ ಅಂಗಡಿಗೆ ವೇಗವಾಗಿ ಮಾರಾಟವಾಗುವ ಪಾನೀಯ, ಸ್ನ್ಯಾಕ್ಸ್, ಮಸಾಲೆ ಮತ್ತು FMCG ಉತ್ಪನ್ನಗಳು. ವಾಟ್ಸಾಪ್‌ನಲ್ಲಿ ಆರ್ಡರ್ ಮಾಡಿ, ಅನುಕೂಲಕರ ಡೆಲಿವರಿ ಪಡೆಯಿರಿ.",
    eyebrow: "ಚಿಲ್ಲರೆ ಅಂಗಡಿಗಳಿಗೆ",
    h1: "ವೇಗವಾಗಿ ಮಾರಾಟವಾಗುವ ಸ್ಟಾಕ್‌ನಿಂದ ನಿಮ್ಮ ಶೆಲ್ಫ್ ಸದಾ ತುಂಬಿರಲಿ",
    lede: "ಬೆಂಗಳೂರಿನಾದ್ಯಂತ ಕಿರಾಣಿ ಅಂಗಡಿಗಳು, ಸೂಪರ್‌ಮಾರ್ಕೆಟ್‌ಗಳು, ಬೇಕರಿಗಳು, ಕೆಫೆಗಳು ಮತ್ತು ಸಗಟು ವ್ಯಾಪಾರಿಗಳು ತಮ್ಮ ಗ್ರಾಹಕರು ಕೇಳುವ ಪಾನೀಯ ಮತ್ತು FMCG ಉತ್ಪನ್ನಗಳ ನಿರಂತರ ಪೂರೈಕೆಗಾಗಿ ನಮ್ಮನ್ನು ನಂಬುತ್ತಾರೆ.",
    heroAlt: "ಕರುನಾಡು ಡಿಸ್ಟ್ರಿಬ್ಯೂಟರ್ಸ್‌ನಿಂದ ಸ್ಟಾಕ್ ಪಡೆಯುತ್ತಿರುವ ಅಂಗಡಿ",
    register: "ನಿಮ್ಮ ಅಂಗಡಿ ನೋಂದಾಯಿಸಿ",
    priceList: "ಬೆಲೆ ಪಟ್ಟಿ ಪಡೆಯಿರಿ",
    priceMsg: "ನಮಸ್ಕಾರ ಕರುನಾಡು ಡಿಸ್ಟ್ರಿಬ್ಯೂಟರ್ಸ್, ನನ್ನ ಅಂಗಡಿಗೆ ಇತ್ತೀಚಿನ ಬೆಲೆ ಪಟ್ಟಿ ಕಳುಹಿಸಿ.",
    whyEyebrow: "ನಮ್ಮಿಂದ ಏಕೆ ಸ್ಟಾಕ್ ಪಡೆಯಬೇಕು",
    whyTitle: "ಅಂಗಡಿಗಳ ನಿಜವಾದ ಕೆಲಸದ ರೀತಿಗೆ ತಕ್ಕಂತೆ",
    benefits: [["ವಾಟ್ಸಾಪ್‌ನಲ್ಲಿ ಆರ್ಡರ್", "ಯಾವಾಗ ಬೇಕಾದರೂ ಪಟ್ಟಿ ಕಳುಹಿಸಿ — ಆ್ಯಪ್, ಲಾಗಿನ್, ಕಷ್ಟದ ಸಾಫ್ಟ್‌ವೇರ್ ಬೇಡ."], ["ಅನುಕೂಲಕರ ಡೆಲಿವರಿ", "ಬೆಂಗಳೂರಿನಾದ್ಯಂತ ನಿಯಮಿತ ಮಾರ್ಗಗಳು — ಸ್ಟಾಕ್ ಖಾಲಿಯಾಗುವ ಮೊದಲೇ ತುಂಬಿಸಿಕೊಳ್ಳಿ."], ["ಉತ್ತಮ ಲಾಭಾಂಶ", "ಪ್ರತಿ ಕೇಸ್‌ನಲ್ಲೂ ನಿಮ್ಮ ಲಾಭ ಕಾಪಾಡುವ ಸ್ಪರ್ಧಾತ್ಮಕ ವ್ಯಾಪಾರ ಬೆಲೆ."], ["ಮಾರಾಟವಾಗುವ ಉತ್ಪನ್ನಗಳು", "ಗ್ರಾಹಕರು ಕೇಳುವ ಟ್ರೆಂಡಿಂಗ್ ಕುಲ್ಕಿ ಡ್ರಿಂಕ್ಸ್, ಗೋಲಿ ಸೋಡಾ, ಸ್ನ್ಯಾಕ್ಸ್ ಮತ್ತು ಅಡುಗೆ ಅಗತ್ಯಗಳು."], ["ಯೋಜನೆಗಳು & ಆಫರ್‌ಗಳು", "ಬ್ರ್ಯಾಂಡ್ ಯೋಜನೆಗಳು, ಹಬ್ಬದ ಆಫರ್‌ಗಳು ಮತ್ತು ಹೊಸ ಉತ್ಪನ್ನಗಳ ಡೀಲ್‌ಗಳನ್ನು ತಕ್ಷಣ ತಲುಪಿಸುತ್ತೇವೆ."], ["ಒಬ್ಬರೇ ಸಂಪರ್ಕ ವ್ಯಕ್ತಿ", "ನಿಮ್ಮ ಅಂಗಡಿ ಮತ್ತು ಆರ್ಡರ್‌ಗಳನ್ನು ಬಲ್ಲ, ನಿಮ್ಮ ಪ್ರದೇಶಕ್ಕೆ ಮೀಸಲಾದ ವ್ಯಕ್ತಿ."]],
    howEyebrow: "ಆರ್ಡರ್ ಮಾಡುವ ವಿಧಾನ",
    howTitle: "ನಾಲ್ಕು ಹಂತಗಳು, ಕಾಗದಪತ್ರ ಬೇಡ",
    steps: [["ಪಟ್ಟಿ ತಯಾರಿಸಿ", "ಯಾವುದೇ ಉತ್ಪನ್ನದಲ್ಲಿ <strong>ಆರ್ಡರ್‌ಗೆ ಸೇರಿಸಿ</strong> ಒತ್ತಿ, ಅಥವಾ ನೇರವಾಗಿ ಪಟ್ಟಿ ಟೈಪ್ ಮಾಡಿ."], ["ವಾಟ್ಸಾಪ್‌ನಲ್ಲಿ ಕಳುಹಿಸಿ", "ಅಂಗಡಿ ಹೆಸರು ಮತ್ತು ಪ್ರದೇಶ ಸೇರಿಸಿ, ಕಳುಹಿಸು ಒತ್ತಿ."], ["ಖಚಿತತೆ & ಸಮಯ", "ಸ್ಟಾಕ್, ಬೆಲೆ ಮತ್ತು ಡೆಲಿವರಿ ಸಮಯವನ್ನು ನಾವು ಖಚಿತಪಡಿಸುತ್ತೇವೆ."], ["ಪಡೆಯಿರಿ & ಮಾರಿ", "ನಿಮಗೆ ಅನುಕೂಲವಾದ ಸಮಯಕ್ಕೆ ನಿಮ್ಮ ಬಾಗಿಲಿಗೆ ತಲುಪಿಸುತ್ತೇವೆ."]],
    startEyebrow: "ಆರ್ಡರ್ ಆರಂಭಿಸಿ",
    startTitle: "ಗ್ರಾಹಕರ ಮೆಚ್ಚಿನವು",
    fullCatalogue: "ಪೂರ್ಣ ಕ್ಯಾಟಲಾಗ್",
    orderCta: "<strong>ಪಟ್ಟಿ ಸಿದ್ಧವೇ?</strong> ಆರ್ಡರ್ ಪಟ್ಟಿ ತೆರೆದು ವಾಟ್ಸಾಪ್‌ನಲ್ಲಿ ಕಳುಹಿಸಿ.",
    viewList: "ಆರ್ಡರ್ ಪಟ್ಟಿ ನೋಡಿ",
    faqEyebrow: "ಪ್ರಶ್ನೆಗಳು",
    faqTitle: "ಅಂಗಡಿಗಳ ಸಾಮಾನ್ಯ ಪ್ರಶ್ನೆಗಳು",
    faqs: [
      ["ಕನಿಷ್ಠ ಆರ್ಡರ್ ಪ್ರಮಾಣ ಇದೆಯೇ?", "ಕನಿಷ್ಠ ಪ್ರಮಾಣ ಉತ್ಪನ್ನ ಮತ್ತು ನಿಮ್ಮ ಪ್ರದೇಶವನ್ನು ಅವಲಂಬಿಸಿದೆ. ನಿಮ್ಮ ಪಟ್ಟಿಯನ್ನು ವಾಟ್ಸಾಪ್‌ನಲ್ಲಿ ಕಳುಹಿಸಿ — ನಿಮ್ಮ ಅಂಗಡಿಗೆ ಸೂಕ್ತವಾದುದನ್ನು ನಮ್ಮ ತಂಡ ತಿಳಿಸುತ್ತದೆ. ಸಣ್ಣ ಕಿರಾಣಿ ಅಂಗಡಿಗಳಿಗೂ ಸ್ವಾಗತ."],
      ["ಯಾವ ಪ್ರದೇಶಗಳಿಗೆ ಡೆಲಿವರಿ ಮಾಡುತ್ತೀರಿ?", `ಬೆಂಗಳೂರಿನಾದ್ಯಂತ ಡೆಲಿವರಿ ಮಾಡುತ್ತೇವೆ; ${nearAreas} ಪ್ರದೇಶಗಳಿಗೆ ಅತಿ ವೇಗದ ಸೇವೆ. ರಾಜ್ಯದ ಇತರೆಡೆಯ ಆರ್ಡರ್‌ಗಳನ್ನು ನಮ್ಮ ಕರ್ನಾಟಕ ಜಾಲದ ಮೂಲಕ ನಿರ್ವಹಿಸುತ್ತೇವೆ.`],
      ["ನನ್ನ ಆರ್ಡರ್ ಎಷ್ಟು ಬೇಗ ಬರುತ್ತದೆ?", "ಖಚಿತಪಡಿಸಿದ ಆರ್ಡರ್‌ಗಳು ನಮ್ಮ ನಿಯಮಿತ ಸ್ಥಳೀಯ ಮಾರ್ಗಗಳಲ್ಲಿ ತಲುಪುತ್ತವೆ — ನಿಮ್ಮ ಅಂಗಡಿಗೆ ಅನುಕೂಲವಾದ ಸಮಯ ನಿಗದಿಪಡಿಸುತ್ತೇವೆ."],
      ["ಇತ್ತೀಚಿನ ಬೆಲೆ ಪಟ್ಟಿ ಹೇಗೆ ಪಡೆಯುವುದು?", "“ಬೆಲೆ ಪಟ್ಟಿ ಪಡೆಯಿರಿ” ಒತ್ತಿ ಅಥವಾ ವಾಟ್ಸಾಪ್‌ನಲ್ಲಿ ಸಂದೇಶ ಕಳುಹಿಸಿ — ನಿಮ್ಮ ಪ್ರದೇಶದ ಇತ್ತೀಚಿನ ಕ್ಯಾಟಲಾಗ್ ಮತ್ತು ವ್ಯಾಪಾರ ಬೆಲೆಗಳನ್ನು ಕಳುಹಿಸುತ್ತೇವೆ."],
      ["ಪಾವತಿ ಹೇಗೆ?", "ಮೊದಲ ಆರ್ಡರ್ ಮಾಡುವಾಗ ಪಾವತಿ ಷರತ್ತುಗಳನ್ನು ನಮ್ಮ ತಂಡ ಖಚಿತಪಡಿಸುತ್ತದೆ. ನಿಮ್ಮ ಅಂಗಡಿಗೆ ಲಭ್ಯವಿರುವ ಆಯ್ಕೆಗಳನ್ನು ತಿಳಿಸುತ್ತೇವೆ."],
    ],
  },
}[lang];

const hero = resolveImage("retailer-kirana", "tusk-range");
const quick = products.filter((p) => p.featured).slice(0, 4);
const benefitIcons = ["whatsapp", "truck", "rupee", "star", "megaphone", "users"];
---
<Base title={copy.title} description={copy.description}>
  <PageHero eyebrow={copy.eyebrow} title={copy.h1} lede={copy.lede} image={hero} imageAlt={copy.heroAlt} crumbs={[{ href: "/retailers/", label: copy.title }]}>
    <div class="btn-row">
      <a class="btn btn--red" href="#retailer-form"><Icon name="store" /> {copy.register}</a>
      <a class="btn btn--wa" href={waLink(copy.priceMsg)} target="_blank" rel="noopener"><Icon name="whatsapp" /> {copy.priceList}</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="wrap">
      <div class="head reveal">
        <p class="eyebrow">{copy.whyEyebrow}</p>
        <h2>{copy.whyTitle}</h2>
      </div>
      <div class="grid grid-3">
        {copy.benefits.map(([title, text], i) => (
          <article class="benefit reveal">
            <span class="benefit__icon"><Icon name={benefitIcons[i]} size={24} /></span>
            <div>
              <h3>{title}</h3>
              <p>{text}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap">
      <div class="head head--center reveal">
        <p class="eyebrow">{copy.howEyebrow}</p>
        <h2>{copy.howTitle}</h2>
      </div>
      <ol class="steps reveal">
        {copy.steps.map(([title, text]) => <li><h3>{title}</h3><p set:html={text} /></li>)}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head-row reveal">
        <div class="head">
          <p class="eyebrow">{copy.startEyebrow}</p>
          <h2>{copy.startTitle}</h2>
        </div>
        <a class="textlink" href={lp(lang, "/products/")}>{copy.fullCatalogue} <Icon name="arrow" /></a>
      </div>
      <div class="products-grid">
        {quick.map((p) => <ProductCard product={p} />)}
      </div>
      <div class="order-cta reveal">
        <p set:html={copy.orderCta} />
        <button type="button" class="btn btn--sun" data-open-order><Icon name="list" /> {copy.viewList}</button>
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="wrap split">
      <div class="reveal">
        <p class="eyebrow">{copy.faqEyebrow}</p>
        <h2>{copy.faqTitle}</h2>
        <div class="faq">
          {copy.faqs.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
        </div>
      </div>
      <div id="retailer-form" class="reveal form-anchor">
        <EnquiryForm mode="retailer" />
      </div>
    </div>
  </section>
</Base>

<style>
  .benefit { display: flex; gap: 14px; align-items: flex-start; padding: 20px; background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); }
  .benefit__icon { flex: none; width: 48px; height: 48px; border-radius: 14px; display: grid; place-items: center; background: var(--sun); color: var(--ink); }
  .benefit h3 { margin-bottom: 4px; font-size: 1.12rem; }
  .benefit p { margin: 0; color: var(--muted); font-size: 0.95rem; }
  .head-row { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 8px 24px; margin-bottom: 28px; }
  .head-row .head { margin-bottom: 0; }
  .order-cta { margin-top: 28px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px; padding: 18px 20px; border-radius: var(--radius); background: var(--ink); color: #fff; }
  .order-cta p { margin: 0; }
  @media (max-width: 479px) { .order-cta .btn { width: 100%; } }
  .form-anchor { scroll-margin-top: calc(var(--header-h) + 16px); }
  .split { align-items: start; }
</style>
