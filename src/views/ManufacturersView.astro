---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import Img from "../components/Img.astro";
import EnquiryForm from "../components/EnquiryForm.astro";
import { site, waLink } from "../data/site";
import { categories, catName } from "../data/catalog";
import { resolveImage } from "../lib/images";
import { getLang } from "../i18n";

const lang = getLang(Astro.url);
const catList = categories.map((c) => catName(c, lang)).join(", ");
const copy = {
  en: {
    title: "For Manufacturers",
    description: "Grow your food, beverage or FMCG brand in Bengaluru and Karnataka. Karunadu Distributors offers a ready retail network, reliable delivery and brand visibility.",
    eyebrow: "For brands & manufacturers",
    h1: "Put your brand on every shelf in Bengaluru",
    lede: "We help emerging and established manufacturers scale their market footprint across supermarkets, kirana stores and wholesale channels — through active distribution, timely delivery and dedicated support.",
    heroAlt: "Brand products ready for distribution",
    partner: "Become a partner",
    talk: "Talk to us",
    offersEyebrow: "What you get",
    offersTitle: "More than a delivery partner",
    offersLede: "We actively sell your product into the market, keep it in stock, and make sure retailers and shoppers notice it.",
    offers: [["Ready retail network", "Immediate access to 500+ active outlets — supermarkets, kirana stores, bakeries and wholesalers."], ["Reliable last-mile delivery", "Own vans on daily beat routes with 24–48 hour replenishment, so your product stays on the shelf."], ["Brand visibility", "Vehicle branding across Bengaluru, shelf placement and push for your schemes and launches."], ["Market feedback", "On-ground insight into what's selling, where, and what retailers are asking for."], ["Active sales team", "Field team that introduces new products to retailers rather than waiting for orders."], ["Hassle-free onboarding", "Clear commercial terms and a single point of contact for your brand."]],
