    procEyebrow: "Partnership process",
    procTitle: "From first call to first shelf",
    process: [["Share your products", "Send us your range, pack sizes, pricing and FSSAI / compliance details."], ["Fit assessment", "We review demand, margins and the right outlets and areas for your brand."], ["Agree terms", "Simple distribution terms, launch plan and initial stock quantities."], ["Launch & grow", "Stock moves to shelves; we report sell-through and scale to more outlets."]],
    faqEyebrow: "Questions",
    faqTitle: "Manufacturer FAQs",
    faqs: [
      ["What kind of brands do you work with?", `Food, beverage and FMCG manufacturers — from emerging regional brands to established names. Our current focus areas are ${catList}.`],
