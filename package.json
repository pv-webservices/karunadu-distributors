  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "^24.19.1",
    "sharp": "0.35.5",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.18"
  }
